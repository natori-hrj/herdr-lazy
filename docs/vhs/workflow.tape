Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set Width 1760
Set Height 660
Set Padding 28
Set Theme "Catppuccin Mocha"
Set CursorBlink false
Set Framerate 24
Set TypingSpeed 120ms

Hide
Type "exec ./launch-demo"
Enter
Sleep 2s
Show

