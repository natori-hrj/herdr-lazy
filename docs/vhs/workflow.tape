Output demo.gif
Output demo.mp4

Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 22
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set CursorBlink false
Set Framerate 24
Set TypingSpeed 120ms

Hide
Type "exec ./launch-demo"
Enter
Sleep 2s
Show

Screenshot manage.png
Sleep 2.2s

Ctrl+P
Sleep 800ms
Screenshot command-palette.png
Sleep 1s
Type "mkt"
Sleep 900ms
Screenshot command-palette-search.png
Sleep 1s

Enter
Sleep 900ms
Screenshot marketplace-catalog.png
Sleep 800ms
Type "worktree"
Sleep 1s
Screenshot marketplace.png
Ctrl+R
Sleep 900ms
Screenshot marketplace-refresh.png
Sleep 2.4s

Escape
Sleep 500ms
Type "l"
Sleep 900ms
Screenshot details.png
Sleep 2.3s

Escape
Sleep 500ms
Type "T"
Sleep 600ms
Up 5
Down
Sleep 1.2s
Screenshot theme-catppuccin.png
Sleep 1.2s
Down
Sleep 1.2s
Screenshot theme-selection.png
Sleep 1.2s
Down 2
Sleep 1s
Enter
Sleep 1s
